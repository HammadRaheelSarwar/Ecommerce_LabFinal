# ============================================================
# All Available — Environment Variables Template
# Copy this file to server/.env and fill in your values
# ============================================================

# Supabase (Primary PostgreSQL Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp & Direct Ordering
WHATSAPP_NUMBER=+923064538251
ORDER_EMAIL=allavailable.shooping@gmail.com

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# Admin Seed Credentials
ADMIN_EMAIL=admin@allavailable.com
ADMIN_PASSWORD=AdminPass123!

# App Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary (Optional — for direct media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=allavailable.shooping@gmail.com
SMTP_PASS=
EMAIL_FROM=allavailable.shooping@gmail.com
