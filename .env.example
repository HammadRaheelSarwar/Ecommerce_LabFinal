# ============================================================
# All Available — Environment Variables Template
# Copy this file to server/.env and fill in your values
# ============================================================

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/all_available

# JWT (use long random strings in production)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# Admin Seed Credentials
# These are ONLY used during 'npm run seed' to create the first admin.
# Change immediately after first login.
ADMIN_EMAIL=admin@allavailable.com
ADMIN_PASSWORD=


# Cloudinary (optional — app works without these in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Email (optional — for forgot password, order confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@allavailable.com
